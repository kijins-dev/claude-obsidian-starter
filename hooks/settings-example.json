{
  "_comment": "~/.claude/settings.json へマージする例。既にhooksがある場合は各イベントの配列へ追記する。~ が効かない場合は絶対パス（/Users/あなた/.claude/hooks/...）に書き換える",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "node ~/.claude/hooks/session-start-context.js", "timeout": 10 },
          { "type": "command", "command": "node ~/.claude/hooks/session-title.js", "timeout": 5 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "node ~/.claude/hooks/session-title.js", "timeout": 5 }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "node ~/.claude/hooks/pre-compact-handover.js", "timeout": 30 }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "node ~/.claude/hooks/stop-daily-note.js", "timeout": 60 }
        ]
      }
    ]
  }
}
